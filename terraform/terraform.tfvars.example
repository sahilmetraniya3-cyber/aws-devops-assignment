aws_region        = "ap-south-1"
project_name      = "devops-assignment"
instance_type     = "t3.micro"
ami_id            = "REPLACE_WITH_CURRENT_AMAZON_LINUX_2023_AMI_ID"
certificate_arn   = "arn:aws:acm:ap-south-1:123456789012:certificate/REPLACE_ME"
db_name           = "appdb"
db_username       = "appuser"
# Do not put a real password here. Export TF_VAR_db_password in your shell instead.
enable_nat_gateway = true
