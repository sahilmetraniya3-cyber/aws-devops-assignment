#!/bin/bash
set -euxo pipefail

dnf install -y python3 python3-pip

mkdir -p /opt/devops-app
cat > /opt/devops-app/app.py <<'PY'
${app_source}
PY

cat > /opt/devops-app/requirements.txt <<'REQ'
${requirements}
REQ

python3 -m venv /opt/devops-app/venv
/opt/devops-app/venv/bin/pip install --no-cache-dir \
  -r /opt/devops-app/requirements.txt

chown -R ec2-user:ec2-user /opt/devops-app

cat > /etc/systemd/system/devops-app.service <<'UNIT'
[Unit]
Description=DevOps assignment Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/devops-app
Environment=APP_NAME=${app_name}
Environment=DB_SECRET_ARN=${secret_arn}
Environment=AWS_REGION=${aws_region}
ExecStart=/opt/devops-app/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:${app_port} app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now devops-app
