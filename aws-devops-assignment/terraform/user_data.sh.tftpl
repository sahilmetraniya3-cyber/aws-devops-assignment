#!/bin/bash
set -euxo pipefail
dnf update -y
dnf install -y python3 python3-pip
mkdir -p /opt/devops-app
cat >/opt/devops-app/app.py <<'PY'
import os, json, logging
from http.server import BaseHTTPRequestHandler, HTTPServer
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            body = b'{"status":"ok"}'
            self.send_response(200); self.send_header("Content-Type","application/json")
        else:
            body = ("""<!doctype html><html><head><title>${app_name}</title></head>
            <body><h1>${app_name}</h1><p>Application is running on an EC2 Auto Scaling instance.</p>
            <p>Health check: <a href="/health">/health</a></p></body></html>""").encode()
            self.send_response(200); self.send_header("Content-Type","text/html")
        self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
HTTPServer(("0.0.0.0", ${app_port}), Handler).serve_forever()
PY
cat >/etc/systemd/system/devops-app.service <<'UNIT'
[Unit]
Description=DevOps assessment sample web app
After=network-online.target
[Service]
User=nobody
WorkingDirectory=/opt/devops-app
Environment=APP_NAME=${app_name}
Environment=DB_SECRET_ARN=${secret_arn}
Environment=AWS_REGION=${aws_region}
ExecStart=/usr/bin/python3 /opt/devops-app/app.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
UNIT
chmod 755 /opt/devops-app
systemctl daemon-reload
systemctl enable --now devops-app
